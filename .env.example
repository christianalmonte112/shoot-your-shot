# Public key from the Vapi dashboard (Account → API Keys).
# The Web SDK runs in the browser, so this must be NEXT_PUBLIC_.
# Do not put the private server key here.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=

# Assistant whose system prompt is docs/buyer-prompt.md.
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# Supabase project URL and the anon (public) key.
# The anon key is meant for the browser. Row-level security keeps rows private.
# Do not put the service-role key in this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
